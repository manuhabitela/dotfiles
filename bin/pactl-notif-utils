#!/bin/bash

wanted="${1}"

get_current_volume() {
	LC_ALL=C pactl list sinks | grep '^[[:space:]]Volume:' | head -n $(( $SINK + 1 )) | tail -n 1 | sed -e 's,.* \([0-9][0-9]*\)%.*,\1,'
}

get_muted_state() {
	LC_ALL=C pactl list sinks | awk '/Mute/ { print $2 }'
}

get_mic_info() {
	default_mic_id=$(LC_ALL=C pactl get-default-source)
	LC_ALL=C pactl --format=json list sources | jq --arg mic_id "$default_mic_id" '.[] | select(.name == $mic_id)'
}

get_mic_muted_state() {
	mic_info=$(get_mic_info)
	echo $mic_info | jq '.mute'
}

get_mic_name() {
	mic_info=$(get_mic_info)
	echo $mic_info | jq -r '.description'
}

get_mic_volume() {
	mic_info=$(get_mic_info)
	echo $mic_info | jq -r '.volume | to_entries | .[0].value.value_percent'
}

if [[ $wanted == "text" ]]; then
	muted=$(get_muted_state)
	current=$(get_current_volume)
	bin_dir=$(dirname $BASH_SOURCE[0])
	if [[ "${muted}" =~ "yes" ]]; then
		echo $($bin_dir/progress-bar 0 15)"  "0 % "Sourdine"
	else
		echo $($bin_dir/progress-bar $current 15) $current %
	fi
fi

if [[ $wanted == "icon" ]]; then
	muted=$(get_muted_state)
	if [[ "${muted}" =~ "yes" ]]; then
		echo "volume-muted.png"
	else
		current=$(get_current_volume)
		if [[ $current -ge 70 ]]; then
			echo "volume-high.png"
		elif [[ $current -ge 30 ]]; then
			echo "volume-medium.png"
		else
			echo "volume-low.png"
		fi
	fi
fi

if [[ $wanted == "mic-muted-state" ]]; then
	muted=$(get_mic_muted_state)
	if [[ "${muted}" =~ "true" ]]; then
		echo 'muted'
	else
		echo 'active'
	fi
fi

if [[ $wanted == "mic-notif-title" ]]; then
	muted=$(get_mic_muted_state)
	if [[ "${muted}" =~ "true" ]]; then
		echo 'Micro coupé'
	else
		echo 'Micro activé'
	fi
fi

if [[ $wanted == "mic-name" ]]; then
	get_mic_name
fi

if [[ $wanted == "mic-notif-description" ]]; then
	echo "$(get_mic_name) ($(get_mic_volume))"
fi

if [[ $wanted == "mic-icon" ]]; then
	muted=$(get_mic_muted_state)
	if [[ "${muted}" =~ "true" ]]; then
		echo "mic-muted.svg"
	else
		echo "mic-high.svg"
	fi
fi
