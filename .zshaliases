#!/bin/zsh

alias cat="bat"

alias l="LC_COLLATE=C eza -la --group-directories-first"
#alias lk="LC_COLLATE=C eza -l --group-directories-first"
alias ll="LC_COLLATE=C eza -1a --group-directories-first"

alias mkdir="mkdir -p"

# git enhanced graph log
alias glo="git log --graph --pretty=format:'%C(bold red)%h%Creset%C(yellow)%d%Creset %s %Cgreen%cr (%cd) %C(cyan)%an%Creset' --abbrev-commit --date=\"format:%a %d %b\""

# git diff with difftastic
alias gdt="GIT_EXTERNAL_DIFF='difft --display=inline' git diff"

# gimme file with ripgrep
alias gmm="rg --no-messages --colors 'line:fg:yellow' --colors 'match:style:nobold' --colors 'match:fg:green' --colors 'path:fg:255,94,94'"
alias gm="ag --color-line-number=\"0;33\" --color-match=\"0;32\" --color-path=\"0;91\""
alias gmh="gm -G \"\.html$\""
alias gms="gm -G \"\.scss$\""
alias gmv="gm -G \"\.csv$\""
alias gmj="gm -G \"\.(js|ts)x?$\""
alias gmjs="gm -G \"\.js$\""
alias gmts="gm -G \"\.ts$\""
alias gmjn="gm -G \"\.json$\""
alias gmc="gm -G \"\.(less|scss|sass)$\"" #css file
alias gmtw="gm -G .twig$"
alias gmct="gm -G .ctp$"
alias gmt="gm -G \"\.(twig|ctp)$\"" #template files
alias gmf="gm -G \"\.(less|scss|twig|ctp|js|ts)$\"" #front-end file
alias gmp="gm -G \"\.(php|inc)$\"" #php file + php files for a project i maintain
alias gmpi="gm -G .inc$" #php file + php files for a project i maintain

alias dk="docker"
alias dkc="docker compose"
alias dkr="docker compose"

alias dockerps="docker ps --format \"table {{.ID}}\t{{.Names}}\t{{.Status}}\t{{.Ports}}\""

alias -g andn="&& notify-send -i /usr/share/icons/Faenza/apps/16/terminal.png 'Commande terminée'"

alias mon="/home/manu/bin/monitor-p14s"

alias lstn="sudo lsof -i -P -n | grep LISTEN"

#alias android-studio="_JAVA_OPTIONS=-Djava.io.tmpdir=/var/tmp /home/manu/opt/android-studio/bin/studio.sh"

gpo() {
	# check if $1 is passed, if it is, replace "origin" with $1
	current_branch=$(git rev-parse --abbrev-ref HEAD)
	if [ -n "$1" ]; then
		git push -u $1 $current_branch
	else
		git push -u origin $current_branch
	fi
}

gcob() {
	git checkout -b $1 origin/$1
}

unalias gco
# git checkout alias that supports passing branch names from GitHub UI containing repo prefixes
# ie. `gco manuhabitela:issue-366-new-record-button` will checkout `issue-366-new-record-button`
gco() {
	if [ $# -eq 1 ] && [[ "$1" == *:* ]]; then
		# If there's only one argument and it contains a colon
		branch="${1#*:}"  # Strip everything before the colon
		git checkout $branch
	else
		# Otherwise, pass all arguments to git checkout
		git checkout "$@"
	fi
}

switch_file() {
	first_file=$1
	second_file=$2
	mv $first_file $first_file.$$
	mv $second_file $first_file
	mv $first_file.$$ $second_file
}

stopwatch() {
    start=$(date +%s)
    while true; do
        time="$(( $(date +%s) - $start))"
        printf '%s\r' "$(date -u -d "@$time" +%H:%M:%S)"
        sleep 0.1
    done
}

extract() {
	if [ -z "$1" ]; then
		echo "\`extract\` lets you easily extract common archive types"
		echo "Usage: extract archive_file";
		return 1
	fi
	if [ -f $1 ] ; then
		case $1 in
			*.tar.bz2)   tar xjf $1     ;;
			*.tar.gz)    tar xzf $1     ;;
			*.bz2)       bunzip2 $1     ;;
			*.rar)       unrar e $1     ;;
			*.gz)        gunzip $1      ;;
			*.tar)       tar xf $1      ;;
			*.tbz2)      tar xjf $1     ;;
			*.tgz)       tar xzf $1     ;;
			*.zip)       unzip $1       ;;
			*.Z)         uncompress $1  ;;
			*.7z)        7z x $1        ;;
			*)     echo "'$1' cannot be extracted via extract()" ;;
		esac
	else
		echo "'$1' is not a valid file"
	fi
}

transfer() {
	if [ -z "$1" ]; then
		echo "\`transfer\` helps you upload files on https://transfer.sh";
		echo "Usage: transfer file_to_upload";
		return 1
	fi
	curl --upload-file ./$1 https://transfer.sh/$1;
}

# needed for some build stuff looking for jsl instead of jslint
alias jsl="jslint"
alias teensy_loader_cli="teensy-loader-cli"

alias awslocal="AWS_ACCESS_KEY_ID=test AWS_SECRET_ACCESS_KEY=test AWS_DEFAULT_REGION=${DEFAULT_REGION:-$AWS_DEFAULT_REGION} aws --endpoint-url=http://${LOCALSTACK_HOST:-localhost}:4566"
