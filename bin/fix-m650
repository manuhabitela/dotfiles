#!/usr/bin/expect -f

set device "D1:84:81:ED:0E:95"
set timeout 60

spawn bluetoothctl
expect "Agent registered"
send -- "scan on\r"
expect "Discovery started"
send -- "remove $device\r"
send -- "trust $device\r"
expect "Changing $device trust succeeded"
send -- "pair $device\r"
expect "Pairing successful"
send -- "connect $device\r"
expect "Connection successful"
send -- "exit\r"
expect eof
