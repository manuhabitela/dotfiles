#!/usr/bin/env bash

# based on https://github.com/kellya/rofi-sound/tree/main,
# customized output to show current default, add input select, show devices "nicks", filter out unplugged devices

LANG="en_US.utf8"
# Outputs have spaces in them, so let's make \n the IFS
IFS=$'\n'

# Prints one line per device: node.name<TAB>Description<TAB>node.nick (nick may be empty).
# For sinks/sources: omit devices whose Ports: section only lists ports as "not available"
# (typical unplugged HDMI/DP). ROFI_SOUND_SHOW_ALL_SINKS=1 / ROFI_SOUND_SHOW_ALL_SOURCES=1
# disables filtering for that kind.
pactl_parse_node_blocks() {
	local list_kind="$1"
	local default_for_filter="${2:-}"
	local hdr='^Sink #'
	[[ "$list_kind" == "sources" ]] && hdr='^Source #'
	local filter_sinks=0
	local filter_sources=0
	[[ "$list_kind" == "sinks" && -z "${ROFI_SOUND_SHOW_ALL_SINKS:-}" ]] && filter_sinks=1
	[[ "$list_kind" == "sources" && -z "${ROFI_SOUND_SHOW_ALL_SOURCES:-}" ]] && filter_sources=1
	pactl list "$list_kind" | awk -v hdr="$hdr" -v filter_sinks="$filter_sinks" -v filter_sources="$filter_sources" -v default_device="$default_for_filter" '
		function reset_port_state() {
			in_ports = 0
			had_ports = 0
			port_ok = 0
			saw_not_available = 0
		}
		function omit_device() {
			if (default_device != "" && node_name == default_device) {
				return 0
			}
			return ((filter_sinks || filter_sources) && had_ports && saw_not_available && !port_ok)
		}
		function flush() {
			if (node_name != "") {
				if (!omit_device()) {
					print node_name "\t" desc "\t" node_nick
				}
			}
			node_name = ""
			desc = ""
			node_nick = ""
			reset_port_state()
		}
		$0 ~ hdr { flush(); next }
		/^[[:space:]]*Description:/ {
			sub(/^[[:space:]]*Description:[[:space:]]*/, "")
			desc = $0
			next
		}
		/^[[:space:]]*node\.name[[:space:]]*=/ {
			sub(/^[[:space:]]*node\.name[[:space:]]*=[[:space:]]*/, "")
			gsub(/^"|"$/, "", $0)
			node_name = $0
			next
		}
		/^[[:space:]]*node\.nick[[:space:]]*=/ {
			sub(/^[[:space:]]*node\.nick[[:space:]]*=[[:space:]]*/, "")
			gsub(/^"|"$/, "", $0)
			node_nick = $0
			next
		}
		/^[[:space:]]*Ports:/ {
			in_ports = 1
			had_ports = 1
			next
		}
		in_ports && /^[[:space:]]*Active Port:/ {
			in_ports = 0
			next
		}
		in_ports && /^[[:space:]]*Formats:/ {
			in_ports = 0
			next
		}
		in_ports {
			if (/availability: yes|availability: unknown|availability unknown/) {
				port_ok = 1
			}
			if (/not available/) {
				saw_not_available = 1
			}
			next
		}
		END { flush() }
	'
}

# Match rofi line label to node.name
resolve_node_name_from_label() {
	local list_kind="$1"
	local label="$2"
	local node desc nick display
	while IFS=$'\t' read -r node desc nick; do
		[[ -z "$node" ]] && continue
		display="$desc"
		if [[ -n "$nick" ]]; then
			display="${desc} (${nick})"
		fi
		if [[ "$label" == "$display" ]] || [[ "$label" == "$desc" ]]; then
			printf '%s' "$node"
			return 0
		fi
	done < <(pactl_parse_node_blocks "$list_kind")
	return 1
}

# Make script independent on particular implementation of send client
if command -v notify-send > /dev/null 2>&1; then
    SEND="notify-send"
elif command -v dunstify > /dev/null 2>&1; then
    SEND="dunstify"
else
    SEND="/bin/false"
fi

# An option was passed, so let's check it
if [ "$@" ]
then
    # the output from the selection is the device description prepended with "input: " or "output: ", with an optional "*" indicating current default device. Strip all that
    raw_selection="$*"
    if [[ $raw_selection == " " ]]
    then
        $SEND -t 2000 -r 2 -u low "No device selected"
        exit 1
    fi

    is_output=true
    device_description=""
    if [[ $raw_selection == output:* ]]
    then
        device_description=$(echo $raw_selection|cut -d: -f2|xargs)
    elif [[ $raw_selection == input:* ]]
    then
        is_output=false
        device_description=$(echo $raw_selection|cut -d: -f2|xargs)
    else
        $SEND -t 2000 -r 2 -u critical "Device not found: $raw_selection"
        exit 1
    fi

    # if it's the default device, remove that marker
    if [[ $device_description == *"* "* ]]
    then
        device_description=$(echo $device_description|cut -d" " -f2-)
    fi

    sink_or_source="sink"
    input_or_output="output"
    if [ "$is_output" = false ]
    then
        sink_or_source="source"
        input_or_output="input"
    fi

    # Map chosen line (nick + Description or Description alone) back to node.name
    list_kind="sinks"
    [[ "$sink_or_source" == "source" ]] && list_kind="sources"
    device="$(resolve_node_name_from_label "$list_kind" "$device_description")"
    if [[ -z "$device" ]]; then
        device=$(pactl list "${sink_or_source}s" | grep -C2 -F "Description: $device_description" | grep -ie '^[[:space:]]*Name:' | head -1 | cut -d: -f2- | xargs)
    fi
    # Try to set the default to the device chosen
    if pactl set-default-${sink_or_source} "$device"
    then
        $SEND -t 2000 -r 2 -u low "New default $input_or_output: $device_description"
    else
        $SEND -t 2000 -r 2 -u critical "Error with $input_or_output \"$device_description\"" "pactl set-default-${sink_or_source} \"$device\""
    fi
else
    echo -en "\x00prompt\x1fSelect input or output device to use\n"

    # list outputs (prepend node.nick when present)
    default_device_id=$(pactl get-default-sink|xargs)
    while IFS=$'\t' read -r node_name desc nick; do
        [[ -z "$node_name" ]] && continue
        display="$desc"
        if [[ -n "$nick" ]]; then
            display="${desc} (${nick})"
        fi
        if [[ "$node_name" == "$default_device_id" ]]; then
            echo "output: * ${display}"
        else
            echo "output:   ${display}"
        fi
    done < <(pactl_parse_node_blocks sinks "$default_device_id")

    echo " "

    # list inputs (same; hide monitor sources)
    default_device_id=$(pactl get-default-source|xargs)
    while IFS=$'\t' read -r node_name desc nick; do
        [[ -z "$node_name" ]] && continue
        [[ "$desc" == Monitor* ]] && continue
        display="$desc"
        if [[ -n "$nick" ]]; then
            display="${desc} (${nick})"
        fi
        if [[ "$node_name" == "$default_device_id" ]]; then
            echo "input: * ${display}"
        else
            echo "input:   ${display}"
        fi
    done < <(pactl_parse_node_blocks sources "$default_device_id")
fi
