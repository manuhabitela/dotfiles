#!/bin/bash
# required: edid-decode, xrandr, grep, sed, /home/manu/bin/monitor-p14s

# this script is called by a udev rule when the monitor is connected or disconnected:
# KERNEL=="card0", SUBSYSTEM=="drm", ENV{DISPLAY}=":0", ENV{XAUTHORITY}="/home/manu/.Xauthority", ENV{DBUS_SESSION_BUS_ADDRESS}="unix:path=/run/user/1000/bus" RUN+="/usr/bin/su manu -c /home/manu/bin/udev-on-p14s-monitor-change"
# the display and xauthority envs are needed for xrandr to work; the fact we run the script as manu instead of root + the dbus env is needed for the monitor-p14s script to work because it restarts awesome wm

file=/home/manu/bin/prout
rm $file

echo $DISPLAY > $file
echo " " >> $file
echo $XAUTHORITY >> $file
echo " " >> $file
echo $DBUS_SESSION_BUS_ADDRESS >> $file
echo " " >> $file
echo $RANDOM >> $file

internal_monitor="eDP"
external_monitor="HDMI-A-0"

external_is_connected=0
if xrandr -q | grep -q "^$external_monitor connected"; then
	external_is_connected=1
fi

active_monitors=$(xrandr | grep -E " connected (primary )?[1-9]+" | sed -e "s/\([A-Z0-9]\+\) connected.*/\1/")

internal_is_active=0
if [[ $active_monitors == *"$internal_monitor"* ]]; then
    internal_is_active=1
fi

external_is_active=0
if [[ $active_monitors == *"$external_monitor"* ]]; then
    external_is_active=1
fi

external_is_work=0
if edid-decode < /sys/class/drm/card0-HDMI-A-1/edid | grep -q "Serial Number: 39514"; then
	external_is_work=1
fi

# auto switch starts now

# connected work monitor? switch to work monitor only
if [[ $external_is_connected -eq 1 && $external_is_work -eq 1 ]]; then
	/home/manu/bin/monitor-p14s out
	exit 0
fi

# just disconnected external monitor? make sure we see something
if [[ $external_is_connected -eq 0 ]]; then
	/home/manu/bin/monitor-p14s in
	exit 0
fi

exit 0

